---
import { enlaceWhatsapp, telefono } from '../config/agencia';

interface Props {
  mensaje: string;
  etiqueta?: string;
  variante?: 'primario' | 'secundario' | 'cabecera';
}

const { mensaje, etiqueta = 'Escribir por WhatsApp', variante = 'primario' } = Astro.props;
const href = enlaceWhatsapp(mensaje);
const nombre = `${etiqueta}, ${telefono.visible}`;
---

<a class:list={['boton', variante !== 'primario' && `boton--${variante}`]} href={href} aria-label={nombre}>
  {etiqueta}
</a>
