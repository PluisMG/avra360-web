---
interface Paso {
  href?: string;
  etiqueta: string;
}

interface Props {
  pasos: Paso[];
}

const { pasos } = Astro.props;
---

<nav class="migas" aria-label="Ruta">
  <ol>
    {
      pasos.map((paso, indice) => {
        const ultimo = indice === pasos.length - 1;
        return (
          <li>
            {paso.href && !ultimo ? (
              <a href={paso.href}>{paso.etiqueta}</a>
            ) : (
              <span aria-current={ultimo ? 'page' : undefined}>{paso.etiqueta}</span>
            )}
          </li>
        );
      })
    }
  </ol>
</nav>
