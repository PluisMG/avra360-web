---
import EnlaceWhatsapp from './EnlaceWhatsapp.astro';
import { mensajesWhatsapp, mostrarPrecios, precios } from '../config/agencia';
import { servicios } from '../config/textos';
---

<section id="inversion" class:list={['seccion', { 'bloque-apagado': !mostrarPrecios }]} aria-labelledby="inversion-titulo" data-estado={mostrarPrecios ? 'activo' : 'desactivado'}>
  <div class="contenedor">
    <h2 id="inversion-titulo">Inversión</h2>
    {
      mostrarPrecios ? (
        precios.length > 0 ? (
          <div class="tabla-wrap">
            <table>
              <caption>Precios aprobados de los servicios</caption>
              <thead>
                <tr>
                  <th scope="col">Servicio</th>
                  <th scope="col">Monto</th>
                  <th scope="col">Nota</th>
                </tr>
              </thead>
              <tbody>
                {precios.map((precio) => (
                  <tr>
                    <th scope="row">{precio.servicio}</th>
                    <td>{precio.monto}</td>
                    <td>{precio.nota}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        ) : (
          <p>Los precios están habilitados en la configuración, pero todavía no hay montos cargados. Esta página no inventa cifras.</p>
        )
      ) : (
        <>
          <p class="estado-apagado">{servicios.inversionEstado}</p>
          <p>{servicios.inversionTexto}</p>
          <EnlaceWhatsapp mensaje={mensajesWhatsapp.servicios} etiqueta={servicios.inversionEnlace} />
        </>
      )
    }
  </div>
</section>
