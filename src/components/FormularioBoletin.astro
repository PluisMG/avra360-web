---
import { consentimientoBoletin } from '../config/suscripcion';
import { formularioBoletin } from '../config/entorno';
import { formularioBoletinTextos as textos } from '../config/textos';
import Trampa from './Trampa.astro';

interface Props {
  identificador: string;
}

const { identificador } = Astro.props;
const formulario = formularioBoletin();
const ayuda = `${identificador}-ayuda`;
---

<div class="formulario" id={identificador}>
  <h2>{textos.titulo}</h2>
  {
    formulario.listo ? (
      <>
        <form method="post" action="/api/boletin/suscribir" aria-describedby={ayuda}>
          <Trampa />
          <input type="hidden" name="origen" value={Astro.url.pathname} />
          <fieldset>
            <legend class="solo-lectores">{textos.leyendaActiva}</legend>
            <p id={ayuda}>{textos.ayudaActiva}</p>
            <label class="campo">
              <span>Nombre</span>
              <input type="text" name="nombre" autocomplete="name" required maxlength="80" placeholder={textos.placeholderNombre} />
            </label>
            <label class="campo">
              <span>Correo electrónico</span>
              <input
                type="email"
                name="correo"
                autocomplete="email"
                inputmode="email"
                required
                maxlength="120"
                placeholder={textos.placeholderCorreo}
              />
            </label>
            <label class="casilla">
              <input type="checkbox" required name="consentimiento" value={consentimientoBoletin.version} />
              <span>{textos.casilla}</span>
            </label>
            <button class="boton" type="submit">{textos.boton}</button>
          </fieldset>
        </form>
        <p><a href="/aviso-de-privacidad">Leer el aviso de privacidad</a></p>
      </>
    ) : (
      <>
        <p id={ayuda} role="status">{textos.ayudaApagada}</p>
        <form aria-describedby={ayuda} aria-disabled="true">
          <Trampa />
          <fieldset disabled>
            <legend class="solo-lectores">{textos.leyendaApagada}</legend>
            <label class="campo">
              <span>Nombre</span>
              <input type="text" autocomplete="name" placeholder={textos.placeholderNombre} />
            </label>
            <label class="campo">
              <span>Correo electrónico</span>
              <input type="email" autocomplete="email" inputmode="email" placeholder={textos.placeholderCorreo} />
            </label>
            <label class="casilla">
              <input type="checkbox" />
              <span>{textos.casilla}</span>
            </label>
            <button class="boton" type="submit" disabled>{textos.botonApagado}</button>
          </fieldset>
        </form>
        <p><a href="/aviso-de-privacidad">Leer el aviso de privacidad</a></p>
      </>
    )
  }
</div>
