---
import { getCollection } from 'astro:content';
import { agencia } from '../config/agencia';
import { catalogoServicios } from '../config/paginas';
import EnlaceWhatsapp from './EnlaceWhatsapp.astro';

interface Props {
  mensaje: string;
}

const { mensaje } = Astro.props;
const ruta = Astro.url.pathname === '/' ? '/' : Astro.url.pathname.replace(/\/$/, '');
const slugs = new Set((await getCollection('paginas')).map((pagina) => pagina.data.slug));
const servicios = catalogoServicios.filter((servicio) => slugs.has(servicio.slug));
const guia = slugs.has('cofepris');
const nosotros = slugs.has('nosotros');

function activo(href: string) {
  if (href === '/') return ruta === '/';
  return ruta === href || ruta.startsWith(`${href}/`);
}
---

<header class="cabecera">
  <div class="cabecera__barra contenedor">
    <a class="marca" href="/" aria-current={ruta === '/' ? 'page' : undefined}>
      <svg class="marca__signo" width="36" height="36" viewBox="0 0 36 36" aria-hidden="true">
        <rect width="36" height="36" rx="8" fill="#143f38"></rect>
        <path fill="#f3eee6" d="M9 26V11h3.2l5.8 9.1L23.8 11H27v15h-2.8v-9.2L19.4 24h-2.8l-4.8-7.2V26H9z"></path>
      </svg>
      <span>{agencia.nombre}</span>
    </a>
    <div class="cabecera__acciones">
      <EnlaceWhatsapp mensaje={mensaje} etiqueta="WhatsApp" variante="cabecera" />
      <details class="menu">
        <summary>Menú</summary>
        <nav class="enlaces" aria-label="Principal">
          <a href="/" aria-current={activo('/') ? 'page' : undefined}>Inicio</a>
          {
            servicios.length > 0 ? (
              <details class="submenu">
                <summary>Servicios</summary>
                <div class="submenu__panel">
                  <a href="/servicios" aria-current={ruta === '/servicios' ? 'page' : undefined}>
                    Todos los servicios
                  </a>
                  {servicios.map((servicio) => (
                    <a
                      href={`/servicios/${servicio.slug}`}
                      aria-current={ruta === `/servicios/${servicio.slug}` ? 'page' : undefined}
                    >
                      {servicio.menu}
                    </a>
                  ))}
                </div>
              </details>
            ) : (
              <a href="/servicios" aria-current={activo('/servicios') ? 'page' : undefined}>
                Servicios
              </a>
            )
          }
          {guia && <a href="/guias/cofepris" aria-current={activo('/guias') ? 'page' : undefined}>Guías COFEPRIS</a>}
          <a href="/casos/mentalcareclinic" aria-current={activo('/casos/mentalcareclinic') ? 'page' : undefined}>Caso</a>
          <a href="/boletin" aria-current={activo('/boletin') ? 'page' : undefined}>Boletín</a>
          {nosotros && <a href="/nosotros" aria-current={activo('/nosotros') ? 'page' : undefined}>Nosotros</a>}
          <a href="/contacto" aria-current={activo('/contacto') ? 'page' : undefined}>Contacto</a>
        </nav>
      </details>
    </div>
  </div>
</header>
