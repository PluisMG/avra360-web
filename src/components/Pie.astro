---
import { getCollection } from 'astro:content';
import { agencia, enlaceWhatsapp, telefono } from '../config/agencia';
import { pie } from '../config/textos';
import FormularioBoletin from './FormularioBoletin.astro';

interface Props {
  mensaje: string;
}

const { mensaje } = Astro.props;
const slugs = new Set((await getCollection('paginas')).map((pagina) => pagina.data.slug));
const enlaces = [
  { href: '/', etiqueta: 'Inicio' },
  { href: '/servicios', etiqueta: 'Servicios' },
  ...(slugs.has('cofepris') ? [{ href: '/guias/cofepris', etiqueta: 'Guías COFEPRIS' }] : []),
  { href: '/casos/mentalcareclinic', etiqueta: 'Caso' },
  { href: '/boletin', etiqueta: 'Boletín' },
  ...(slugs.has('nosotros') ? [{ href: '/nosotros', etiqueta: 'Nosotros' }] : []),
  { href: '/contacto', etiqueta: 'Contacto' },
  { href: '/aviso-de-privacidad', etiqueta: 'Aviso de privacidad' },
  { href: '/boletin/rss.xml', etiqueta: 'RSS del boletín' },
];
---

<footer class="pie">
  <div class="contenedor pie__rejilla">
    <div>
      <h2>Contacto</h2>
      <p>
        {agencia.nombre}. {agencia.responsable}.<br />
        {agencia.ciudad}, {agencia.estado}, {agencia.pais}.
      </p>
      <p>
        <a href={telefono.tel}>Llamar al {telefono.visible}</a><br />
        <a href={enlaceWhatsapp(mensaje)}>WhatsApp {telefono.visible}</a>
      </p>
      <nav aria-label="Pie">
        <ul>
          {
            enlaces.map((item) => (
              <li>
                <a href={item.href}>{item.etiqueta}</a>
              </li>
            ))
          }
          <li><button type="button" id="consent-reabrir">Preferencias de cookies</button></li>
        </ul>
      </nav>
    </div>
    <FormularioBoletin identificador="suscripcion-pie" />
  </div>
  <div class="contenedor legal">
    <p>{pie.linea}</p>
    <p>{pie.derechos}</p>
  </div>
</footer>
