---
import { getCollection, render } from 'astro:content';
import Migas from '../../components/Migas.astro';
import { mensajeDePagina } from '../../config/agencia';
import { exigirPaginasConocidas, servicioDeSlug } from '../../config/paginas';
import { jsonLdServicio } from '../../config/schema';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const paginas = await getCollection('paginas');
  exigirPaginasConocidas(paginas);
  return paginas
    .filter((pagina) => pagina.data.tipo === 'servicio')
    .map((pagina) => ({
      params: { slug: pagina.data.slug },
      props: { pagina },
    }));
}

const { pagina } = Astro.props;
const servicio = servicioDeSlug(pagina.data.slug);
if (!servicio) throw new Error(`Falta el servicio ${pagina.data.slug} en el catálogo.`);
const { Content } = await render(pagina);
const origen = Astro.site?.origin;
if (!origen) throw new Error('El build necesita SITE para el JSON-LD de la página de servicio.');
const jsonLdExtra = [jsonLdServicio(origen, servicio, pagina.data.descripcion, pagina.data.h1)];
---

<Base
  titulo={pagina.data.titulo}
  descripcion={pagina.data.descripcion}
  mensajeWhatsapp={mensajeDePagina(pagina.data.slug)}
  sufijo={pagina.data.sufijo !== false}
  jsonLdExtra={jsonLdExtra}
>
  <article class="contenedor seccion">
    <Migas
      pasos={[
        { href: '/', etiqueta: 'Inicio' },
        { href: '/servicios', etiqueta: 'Servicios' },
        { etiqueta: pagina.data.h1 },
      ]}
    />
    <h1>{pagina.data.h1}</h1>
    <div class="prosa">
      <Content />
    </div>
  </article>
</Base>
