---
import { getCollection, render } from 'astro:content';
import EnlaceWhatsapp from '../../components/EnlaceWhatsapp.astro';
import Migas from '../../components/Migas.astro';
import { mensajesWhatsapp } from '../../config/agencia';
import { exigirPaginasConocidas } from '../../config/paginas';
import { jsonLdMigas } from '../../config/schema';
import { inicio } from '../../config/textos';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const paginas = await getCollection('paginas');
  exigirPaginasConocidas(paginas);
  return paginas
    .filter((pagina) => pagina.data.tipo === 'guia')
    .map((pagina) => ({
      params: { slug: pagina.data.slug },
      props: { pagina },
    }));
}

const { pagina } = Astro.props;
const { Content } = await render(pagina);
const publicidad = (await getCollection('paginas')).find((item) => item.data.slug === 'publicidad-medica-cofepris');
const origen = Astro.site?.origin;
if (!origen) throw new Error('El build necesita SITE para el JSON-LD de la guía.');
const jsonLdExtra = [jsonLdMigas(origen, pagina.data.slug, pagina.data.h1, 'guias')];
---

<Base
  titulo={pagina.data.titulo}
  descripcion={pagina.data.descripcion}
  mensajeWhatsapp={mensajesWhatsapp.servicios}
  sufijo={pagina.data.sufijo !== false}
  jsonLdExtra={jsonLdExtra}
>
  <article class="contenedor seccion">
    <Migas pasos={[{ href: '/', etiqueta: 'Inicio' }, { etiqueta: pagina.data.h1 }]} />
    <h1>{pagina.data.h1}</h1>
    <p class="nota-clinica">
      Guía informativa. No es asesoría legal; confirme su caso con un abogado sanitario o con COFEPRIS.
    </p>
    <div class="prosa">
      <Content />
      {
        publicidad && (
          <p>
            <a href="/servicios/publicidad-medica-cofepris">{publicidad.data.h1}</a>
          </p>
        )
      }
      <p>
        <a href="/boletin">{inicio.boletinEnlace}</a>
      </p>
    </div>
    <EnlaceWhatsapp mensaje={mensajesWhatsapp.servicios} />
  </article>
</Base>
