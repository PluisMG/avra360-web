---
import { getCollection, render } from 'astro:content';
import Migas from '../../components/Migas.astro';
import { mensajeDePagina } from '../../config/agencia';
import { exigirPaginasConocidas, seoDeGuia } from '../../config/paginas';
import { jsonLdGuia } from '../../config/schema';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const paginas = await getCollection('paginas');
  exigirPaginasConocidas(paginas);
  return paginas
    .filter((pagina) => pagina.data.tipo === 'guia')
    .map((pagina) => ({
      params: { slug: pagina.data.slug },
      props: { pagina },
    }));
}

const { pagina } = Astro.props;
const { Content } = await render(pagina);
const seoGuia = seoDeGuia(pagina.data);
const origen = Astro.site?.origin;
if (!origen) throw new Error('El build necesita SITE para el JSON-LD de la guía.');
const fuentes = [
  ...new Set(
    [...(pagina.body ?? '').matchAll(/\]\((https:\/\/[^)\s]+)\)/g)]
      .map((coincidencia) => coincidencia[1] ?? '')
      .filter((url) => {
        const host = new URL(url).hostname;
        return host === 'gob.mx' || host.endsWith('.gob.mx');
      }),
  ),
];
const jsonLdExtra = [
  jsonLdGuia(origen, {
    slug: pagina.data.slug,
    h1: pagina.data.h1,
    titulo: seoGuia.titulo,
    descripcion: seoGuia.descripcion,
    fuentes,
  }),
];
---

<Base
  titulo={seoGuia.titulo}
  descripcion={seoGuia.descripcion}
  mensajeWhatsapp={mensajeDePagina(pagina.data.slug)}
  sufijo={seoGuia.sufijo}
  jsonLdExtra={jsonLdExtra}
>
  <article class="contenedor seccion">
    <Migas
      pasos={[{ href: '/', etiqueta: 'Inicio' }, { etiqueta: 'Guías' }, { etiqueta: pagina.data.h1 }]}
    />
    <h1>{pagina.data.h1}</h1>
    <div class="prosa">
      <Content />
    </div>
  </article>
</Base>
