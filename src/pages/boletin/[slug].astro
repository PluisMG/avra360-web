---
import { getCollection, render } from 'astro:content';
import Migas from '../../components/Migas.astro';
import { mensajesWhatsapp } from '../../config/agencia';
import { incluirEdicion, ordenarEdiciones } from '../../config/boletin';
import { slugDeEdicion } from '../../config/edicion';
import { formatearFecha } from '../../config/fechas';
import { jsonLdArticulo } from '../../config/schema';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const ediciones = ordenarEdiciones(await getCollection('boletin', incluirEdicion));
  const vistos = new Set<string>();
  return ediciones.map((edicion, indice) => {
    const slug = slugDeEdicion(edicion);
    if (vistos.has(slug)) throw new Error(`Slug de boletín repetido: ${slug}`);
    vistos.add(slug);
    return {
      params: { slug },
      props: {
        edicion,
        anterior: ediciones[indice + 1] ?? null,
        siguiente: ediciones[indice - 1] ?? null,
      },
    };
  });
}

const { edicion, anterior, siguiente } = Astro.props;
const { Content } = await render(edicion);
const mensaje = edicion.data.ejemplo
  ? mensajesWhatsapp.ejemplo
  : `Hola. Leí la edición «${edicion.data.titulo}» del boletín de MKT Creativa.`;
const origen = Astro.site?.origin;
if (!origen) throw new Error('El build necesita SITE para el JSON-LD de la edición.');
const publicado = `${edicion.data.fecha}T08:00:00-06:00`;
const jsonLdExtra = [
  jsonLdArticulo(origen, {
    slug: slugDeEdicion(edicion),
    titulo: edicion.data.titulo,
    descripcion: edicion.data.descripcion,
    fecha: edicion.data.fecha,
    modificado: edicion.data.modificado,
    autor: edicion.data.autor,
    fuentes: edicion.data.fuentes,
    palabras: edicion.data.palabras,
  }),
];
---

<Base
  titulo={edicion.data.titulo}
  descripcion={edicion.data.descripcion}
  mensajeWhatsapp={mensaje}
  noindex={edicion.data.ejemplo}
  sufijo={edicion.data.sufijo !== false}
  ogType="article"
  publicado={publicado}
  jsonLdExtra={jsonLdExtra}
>
  <article class="contenedor seccion">
    <Migas
      pasos={[
        { href: '/', etiqueta: 'Inicio' },
        { href: '/boletin', etiqueta: 'Boletín' },
        { etiqueta: edicion.data.titulo },
      ]}
    />
    <p class="ceja">
      <time datetime={edicion.data.fecha}>{formatearFecha(edicion.data.fecha)}</time>
      · {edicion.data.tema}
    </p>
    <h1>{edicion.data.titulo}</h1>
    {
      edicion.data.ejemplo && (
        <p class="aviso-ejemplo" role="note">
          <strong>Edición de ejemplo, no publicada.</strong> Sirve para mostrar el formato. No reporta clientes,
          campañas ni resultados.
        </p>
      )
    }
    <div class="prosa">
      <Content />
    </div>
    <h2>Notas</h2>
    <ul class="notas">
      {
        edicion.data.notas.map((nota) => (
          <li>
            <h3>{nota.titulo}</h3>
            <p>{nota.texto}</p>
          </li>
        ))
      }
    </ul>
    <aside class="llamado">
      <h2>Llamado a la acción</h2>
      <p>{edicion.data.llamado.texto}</p>
      <a class="boton" href={edicion.data.llamado.enlace}>{edicion.data.llamado.etiqueta}</a>
    </aside>
    {
      (anterior || siguiente) && (
        <nav class="acciones" aria-label="Ediciones">
          {anterior && <a href={`/boletin/${slugDeEdicion(anterior)}`}>Edición anterior</a>}
          {siguiente && <a href={`/boletin/${slugDeEdicion(siguiente)}`}>Siguiente</a>}
        </nav>
      )
    }
  </article>
</Base>
