import { mensajeTrasEnviar } from '../../config/suscripcion';
import Base from '../../layouts/Base.astro';
---

<Base
  titulo={mensajeTrasEnviar}
  descripcion={mensajeTrasEnviar}
  mensajeWhatsapp={mensajesWhatsapp.boletin}
