---
import { getCollection } from 'astro:content';
import FormularioBoletin from '../../components/FormularioBoletin.astro';
import Migas from '../../components/Migas.astro';
import { enlaceWhatsapp, mensajesWhatsapp } from '../../config/agencia';
import { incluirEdicion, ordenarEdiciones } from '../../config/boletin';
import { slugDeEdicion } from '../../config/edicion';
import { formatearFecha } from '../../config/fechas';
import Base from '../../layouts/Base.astro';
import { boletin, seo } from '../../config/textos';

const ediciones = ordenarEdiciones(await getCollection('boletin', incluirEdicion));
---

<Base titulo={seo.boletin.titulo} descripcion={seo.boletin.descripcion} mensajeWhatsapp={mensajesWhatsapp.boletin}>
  <div class="contenedor seccion">
    <Migas pasos={[{ href: '/', etiqueta: 'Inicio' }, { etiqueta: 'Boletín' }]} />
    <h1>{boletin.h1}</h1>
    <p class="lede">{boletin.lede}</p>

    <h2>{boletin.ritmoTitulo}</h2>
    <ul>
      {boletin.ritmo.map((punto) => <li>{punto}</li>)}
    </ul>
    <p>
      <a href="/boletin/rss.xml">{boletin.rss}</a>
    </p>

    <h2>{ediciones.length > 0 ? boletin.archivoTitulo : boletin.vacioTitulo}</h2>
    {
      ediciones.length > 0 ? (
        <ol class="archivo">
          {ediciones.map((edicion) => (
            <li>
              <article>
                <p>
                  <time datetime={edicion.data.fecha}>{formatearFecha(edicion.data.fecha)}</time>
                  {edicion.data.ejemplo ? <strong class="insignia">Ejemplo</strong> : null}
                </p>
                <h3>
                  <a href={`/boletin/${slugDeEdicion(edicion)}`}>{edicion.data.titulo}</a>
                </h3>
                <p>{edicion.data.tema}</p>
                <p class="suave">{edicion.data.descripcion}</p>
              </article>
            </li>
          ))}
        </ol>
      ) : (
        <p>{boletin.vacio}</p>
      )
    }

    <FormularioBoletin identificador="suscripcion" />
    <p>
      ¿Tiene una duda sobre la publicidad de su consultorio?
      <a href={enlaceWhatsapp(mensajesWhatsapp.boletin)}>Escríbanos por WhatsApp</a>.
    </p>
  </div>
</Base>
