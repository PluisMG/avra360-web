---
import { getCollection } from 'astro:content';
import BloquePrecios from '../components/BloquePrecios.astro';
import EnlaceWhatsapp from '../components/EnlaceWhatsapp.astro';
import Migas from '../components/Migas.astro';
import { mensajesWhatsapp } from '../config/agencia';
import { catalogoServicios } from '../config/paginas';
import Base from '../layouts/Base.astro';
import { inicio, seo, servicios } from '../config/textos';

const paginas = await getCollection('paginas');
const porSlug = new Map(paginas.map((pagina) => [pagina.data.slug, pagina]));
const publicados = catalogoServicios.filter((servicio) => porSlug.has(servicio.slug));
const guia = porSlug.get('cofepris');
const resumen = new Map(inicio.servicios.map((tarjeta) => [tarjeta.clave, tarjeta]));
const resumenPorSlug: Record<string, { titulo: string; texto: string } | undefined> = {
  'paginas-web-para-medicos': resumen.get('sitio-web'),
  'seo-local-google-maps': resumen.get('seo-local'),
  'publicidad-medica-cofepris': resumen.get('contenido-cofepris'),
};
---

<Base titulo={seo.servicios.titulo} descripcion={seo.servicios.descripcion} mensajeWhatsapp={mensajesWhatsapp.servicios}>
  <div class="contenedor">
    <Migas pasos={[{ href: '/', etiqueta: 'Inicio' }, { etiqueta: 'Servicios' }]} />
    <h1>{servicios.h1}</h1>
    <p class="lede">{servicios.lede}</p>
  </div>

  {
    servicios.bloques.map((bloque) => (
      <section class="seccion" id={bloque.id} aria-labelledby={`${bloque.id}-titulo`}>
        <div class="contenedor">
          <p class="paso__num">{bloque.numero}</p>
          <h2 id={`${bloque.id}-titulo`}>{bloque.titulo}</h2>
          {bloque.parrafos.map((parrafo) => (
            <p class="prosa">{parrafo}</p>
          ))}
        </div>
      </section>
    ))
  }

  {
    publicados.map((servicio) => {
      const pagina = porSlug.get(servicio.slug);
      const corto = resumenPorSlug[servicio.slug];
      return (
        <section class="seccion" aria-labelledby={`${servicio.slug}-titulo`}>
          <div class="contenedor">
            <h2 id={`${servicio.slug}-titulo`}>
              <a href={`/servicios/${servicio.slug}`}>{corto?.titulo ?? pagina?.data.h1}</a>
            </h2>
            {corto && <p>{corto.texto}</p>}
          </div>
        </section>
      );
    })
  }

  {
    guia && (
      <section class="seccion seccion--banda" aria-labelledby="guia-cofepris">
        <div class="contenedor">
          <h2 id="guia-cofepris">
            <a href="/guias/cofepris">{guia.data.h1}</a>
          </h2>
        </div>
      </section>
    )
  }

  <BloquePrecios />

  <section class="seccion" aria-labelledby="servicios-cierre">
    <div class="contenedor">
      <h2 id="servicios-cierre">{servicios.cierreTitulo}</h2>
      <p>{servicios.cierreTexto}</p>
      <EnlaceWhatsapp mensaje={mensajesWhatsapp.servicios} />
    </div>
  </section>
</Base>
