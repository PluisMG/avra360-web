---
import EnlaceWhatsapp from '../components/EnlaceWhatsapp.astro';
import Migas from '../components/Migas.astro';
import { agencia, telefono, mensajesWhatsapp } from '../config/agencia';
import Base from '../layouts/Base.astro';
import { contacto, seo } from '../config/textos';
---

<Base titulo={seo.contacto.titulo} descripcion={seo.contacto.descripcion} mensajeWhatsapp={mensajesWhatsapp.contacto}>
  <div class="contenedor seccion">
    <Migas pasos={[{ href: '/', etiqueta: 'Inicio' }, { etiqueta: 'Contacto' }]} />
    <h1>{contacto.h1}</h1>
    <p class="lede">{contacto.lede}</p>
    <p class="nota-clinica">{contacto.avisoClinica}</p>

    <h2>{contacto.canalesTitulo}</h2>
    <div class="acciones">
      <EnlaceWhatsapp mensaje={mensajesWhatsapp.contacto} />
      <a class="boton boton--secundario" href={telefono.tel}>Llamar al {telefono.visible}</a>
    </div>

    <h2>{contacto.datosTitulo}</h2>
    <dl class="datos">
      <div>
        <dt>Agencia</dt>
        <dd>{agencia.nombre}</dd>
      </div>
      <div>
        <dt>Responsable</dt>
        <dd>{agencia.responsable}</dd>
      </div>
      <div>
        <dt>WhatsApp y teléfono</dt>
        <dd>{telefono.visible}</dd>
      </div>
      <div>
        <dt>Ciudad</dt>
        <dd>{agencia.ciudad}, {agencia.estado}, {agencia.pais}</dd>
      </div>
      <div>
        <dt>Atendemos</dt>
        <dd>{contacto.atendemos}</dd>
      </div>
    </dl>
  </div>
</Base>
