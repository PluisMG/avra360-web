---
import EnlaceWhatsapp from '../components/EnlaceWhatsapp.astro';
import { mensajesWhatsapp } from '../config/agencia';
import Base from '../layouts/Base.astro';
import { inicio, seo } from '../config/textos';
---

<Base titulo={seo.inicio.titulo} descripcion={seo.inicio.descripcion} mensajeWhatsapp={mensajesWhatsapp.inicio}>
  <div class="contenedor hero">
    <div>
      <p class="ceja">{inicio.ceja}</p>
      <h1>{inicio.h1}</h1>
      <p class="lede">{inicio.lede}</p>
      <p class="apoyo">{inicio.apoyo}</p>
      <div class="acciones">
        <EnlaceWhatsapp mensaje={mensajesWhatsapp.inicio} />
        <a class="boton boton--secundario" href="/servicios">Ver servicios</a>
      </div>
    </div>
    <aside class="ficha" aria-labelledby="ficha-titulo">
      <h2 id="ficha-titulo">{inicio.fichaTitulo}</h2>
      <dl>
        {
          inicio.ficha.map((fila) => (
            <div>
              <dt>{fila.termino}</dt>
              <dd>{fila.detalle}</dd>
            </div>
          ))
        }
      </dl>
    </aside>
  </div>

  <section class="seccion" aria-labelledby="para-quien">
    <div class="contenedor">
      <h2 id="para-quien">{inicio.paraQuienTitulo}</h2>
      <div class="rejilla-2">
        {
          inicio.paraQuien.map((bloque) => (
            <article>
              <h3>{bloque.titulo}</h3>
              <p>{bloque.texto}</p>
            </article>
          ))
        }
      </div>
      <p class="nota-clinica">{inicio.aclaracion}</p>
    </div>
  </section>

  <section class="seccion seccion--banda" aria-labelledby="criterios">
    <div class="contenedor">
      <h2 id="criterios">{inicio.criteriosTitulo}</h2>
      <ol class="criterios">
        {
          inicio.criterios.map((criterio) => (
            <li class="paso">
              <span class="paso__num">{criterio.numero}</span>
              <h3>{criterio.titulo}</h3>
              <p>{criterio.texto}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="seccion" aria-labelledby="servicios-corto">
    <div class="contenedor">
      <h2 id="servicios-corto">{inicio.serviciosTitulo}</h2>
      <p>{inicio.serviciosIntro}</p>
      <ul class="lista-servicios">
        {
          inicio.servicios.map((servicio) => (
            <li>
              <a href={servicio.href}>
                <span>
                  <strong>{servicio.titulo}</strong>
                  <span class="suave">{servicio.texto}</span>
                </span>
                <span class="ver">Ver</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="seccion seccion--banda" aria-labelledby="caso-teaser">
    <div class="contenedor">
      <h2 id="caso-teaser">{inicio.casoTitulo}</h2>
      <p class="lede">{inicio.casoTexto}</p>
      <p class="nota-clinica">{inicio.casoRelacion}</p>
      <p><a href="/casos/mentalcareclinic">{inicio.casoEnlace}</a></p>
    </div>
  </section>

  <section class="seccion" aria-labelledby="boletin-teaser">
    <div class="contenedor">
      <h2 id="boletin-teaser">{inicio.boletinTitulo}</h2>
      <p>{inicio.boletinTexto}</p>
      <p><a href="/boletin">{inicio.boletinEnlace}</a></p>
    </div>
  </section>

  <section class="seccion seccion--banda" aria-labelledby="cierre">
    <div class="contenedor">
      <h2 id="cierre">{inicio.cierreTitulo}</h2>
      <p>{inicio.cierreTexto}</p>
      <div class="acciones">
        <EnlaceWhatsapp mensaje={mensajesWhatsapp.inicio} />
        <a class="boton boton--secundario" href="/contacto">Ver contacto</a>
      </div>
    </div>
  </section>
</Base>
