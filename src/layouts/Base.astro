---
import inter400 from '@fontsource/inter/files/inter-latin-400-normal.woff2?url';
import { marca, origenVistaPrevia } from '../brand/logo';
import '../styles/fuentes.css';
import '../styles/global.css';

interface Props {
  titulo: string;
  descripcion: string;
  robots?: string;
}

const { titulo, descripcion, robots } = Astro.props;
const vistaPrevia = process.env.PREVIEW === '1';
const robotsFinal = robots ?? (vistaPrevia ? 'noindex, nofollow' : undefined);
const origenOg = vistaPrevia ? origenVistaPrevia : (Astro.site?.origin ?? 'https://avra360.example');
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    {robotsFinal && <meta name="robots" content={robotsFinal} />}
    <meta name="theme-color" content="#ffffff" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:image" content={new URL(marca.og, origenOg)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <link rel="icon" href={marca.favicon.svg} type="image/svg+xml" />
    <link rel="icon" href={marca.favicon.ico} sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href={marca.favicon.apple} />
    <link rel="preload" href={inter400} as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <slot />
  </body>
</html>
