---
import '../styles/global.css';
import { agencia } from '../config/agencia';
import { vistaPrevia } from '../config/entorno';
import { jsonLdProfesional, urlCanonica } from '../config/jsonld';
import Cabecera from '../components/Cabecera.astro';
import Consentimiento from '../components/Consentimiento.astro';
import Pie from '../components/Pie.astro';

interface Props {
  titulo: string;
  descripcion: string;
  mensajeWhatsapp: string;
  noindex?: boolean;
}

const { titulo, descripcion, mensajeWhatsapp, noindex = false } = Astro.props;
const tituloDocumento = `${titulo} | ${agencia.nombre}`;
const canonica = Astro.site ? urlCanonica(Astro.site, Astro.url.pathname) : Astro.url.href;
const robots = vistaPrevia || noindex ? 'noindex, nofollow' : 'index, follow';
const jsonLd = jsonLdProfesional(Astro.site?.origin ?? new URL(canonica).origin);
const imagen = new URL('/og.png', canonica).href;
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloDocumento}</title>
    <meta name="description" content={descripcion} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#143f38" />
    <meta name="color-scheme" content="light" />
    <link rel="canonical" href={canonica} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={`Boletín ${agencia.nombre}`} href="/boletin/rss.xml" />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={agencia.nombre} />
    <meta property="og:title" content={tituloDocumento} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonica} />
    <meta property="og:image" content={imagen} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="MKT Creativa, marketing para clínicas en Tuxtla Gutiérrez, Chiapas" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={tituloDocumento} />
    <meta name="twitter:description" content={descripcion} />
    <meta name="twitter:image" content={imagen} />
    <script type="application/ld+json" set:html={jsonLd} is:inline />
  </head>
  <body>
    <a class="saltar" href="#contenido">Saltar al contenido</a>
    <Cabecera mensaje={mensajeWhatsapp} />
    <main id="contenido" tabindex="-1">
      <slot />
    </main>
    <Consentimiento />
    <Pie mensaje={mensajeWhatsapp} />
    <script is:inline src="/scripts/consentimiento.js" defer></script>
  </body>
</html>
