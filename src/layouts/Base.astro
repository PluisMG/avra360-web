---
import inter400 from '@fontsource/inter/files/inter-latin-400-normal.woff2?url';
import '../styles/fuentes.css';
import '../styles/global.css';

interface Props {
  titulo: string;
  descripcion: string;
  robots?: string;
}

const { titulo, descripcion, robots } = Astro.props;
const vistaPrevia = process.env.PREVIEW === '1';
const robotsFinal = robots ?? (vistaPrevia ? 'noindex, nofollow' : undefined);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    {robotsFinal && <meta name="robots" content={robotsFinal} />}
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={inter400} as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <slot />
  </body>
</html>
