# Vista previa interna. Con PREVIEW=1 el sitio lleva noindex y robots.txt
# responde Disallow: /.
PREVIEW=1

# El chat solo llama a AVRA si CHAT_ACTIVO es exactamente "1" y existen
# los cuatro secrets y PUBLIC_TURNSTILE_SITE_KEY. Cualquier otro valor
# deja el chat en configuración.
CHAT_ACTIVO=
PUBLIC_TURNSTILE_SITE_KEY=
ALMACENAMIENTO_ACTIVO=
AVISO_APROBADO=

# URL canónica del build. Si no se define, el build usa https://avra360.example.
# SITE=https://tu-dominio.mx

# avra (predeterminado) habla con el webhook. hibrido responde con OpenAI
# si existe el secret OPENAI_API_KEY; si no, usa el mismo webhook.
CHAT_MODO=avra
OPENAI_MODELO=gpt-6-luna

# Secrets, solo en Cloudflare. No los ponga en este archivo ni en el repositorio:
# AVRA_WEBHOOK_URL
# AVRA_WEBHOOK_KEY
# AVRA_REPLY_SIGNING_SECRET
# TURNSTILE_SECRET_KEY
# OPENAI_API_KEY
