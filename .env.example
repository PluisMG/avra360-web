# URL canónica. El lanzamiento la exige: hay que compilar con el dominio real
# y sin PREVIEW. Si no se define, el build usa https://mktcreativa.example.
# SITE=https://tu-dominio.mx

# Vista previa: cada página lleva noindex y robots.txt queda en Disallow: /
# PREVIEW=1

# Edición de ejemplo del boletín.
# 1 la incluye en el build. 0 la oculta también en `npm run dev`.
# Si no se define, el build de producción la omite y el servidor de desarrollo la muestra.
# PUBLIC_MOSTRAR_EDICION_EJEMPLO=0

# Formulario del boletín. Solo "1" lo muestra listo para enviar.
# Los secrets de Resend no van aquí: wrangler secret put.
# BOLETIN_ACTIVO=
# URL publicada del aviso de privacidad para el correo de confirmación.
# Déjela vacía mientras esa página no esté en el build.
# BOLETIN_AVISO_URL=

# Identificadores públicos de medición. El sitio no carga estos scripts
# hasta que la persona acepta las cookies. Vacíos = no se inserta nada.
# PUBLIC_GA4_ID=
# PUBLIC_META_PIXEL_ID=

# Recolector de reportes CSP. Déjalo sin definir: no hay endpoint.
# Solo si existe un recolector propio, pon aquí su URL https absoluta.
# Entonces el build emite report-uri, report-to y Reporting-Endpoints.
# La URL se publica en los encabezados; no pongas un secreto.
# CSP_REPORT_URL=
