# URL canónica. Defínela antes de publicar, con un dominio que controles.
# SITE=https://tu-dominio.mx

# Vista previa: cada página lleva noindex y robots.txt queda en Disallow: /
# PREVIEW=1

# Edición de ejemplo del boletín.
# 1 la incluye en el build. 0 la oculta también en `npm run dev`.
# Si no se define, el build de producción la omite y el servidor de desarrollo la muestra.
# PUBLIC_MOSTRAR_EDICION_EJEMPLO=0

# MailerLite: URL pública de acción del formulario embebido. No es un secreto.
# Nunca pongas la API key en esta variable ni en ninguna variable PUBLIC_.
# Si la URL trae api_key, token o secret, el sitio no muestra el formulario.
# PUBLIC_MAILERLITE_FORM_ACTION=
# PUBLIC_MAILERLITE_EMAIL_FIELD=fields[email]
# PUBLIC_MAILERLITE_NAME_FIELD=fields[name]
# Opcional. Si existe en tu formulario, ahí se guarda la casilla de consentimiento.
# PUBLIC_MAILERLITE_CONSENT_FIELD=

# Identificadores públicos de medición. El sitio no carga estos scripts
# hasta que la persona acepta las cookies. Vacíos = no se inserta nada.
# PUBLIC_GA4_ID=
# PUBLIC_META_PIXEL_ID=
