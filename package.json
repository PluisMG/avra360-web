{
  "name": "avra360-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "predev": "node scripts/cliente.mjs",
    "prebuild": "node scripts/cliente.mjs",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check && tsc -p worker/tsconfig.json --noEmit",
    "test": "vitest run && node --experimental-strip-types --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "empaquetar": "node scripts/empaquetar.mjs",
    "types": "wrangler types"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "astro": "7.4.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@cloudflare/vitest-plugin": "1.4.11",
    "@cloudflare/workers-types": "^5.20261023.1",
    "@emnapi/runtime": "^1.5.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.19.1",
    "axe-core": "4.10.3",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vitest": "4.1.0",
    "wrangler": "4.156.0"
  }
}
